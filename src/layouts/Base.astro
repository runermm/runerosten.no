---
import '../styles/global.css';
import { SITE, NAV, NEWSLETTER } from '../config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string; // bilde ved deling i sosiale medier
  tagline?: { quote: string; source: string }; // tynn sitatlinje under menyen
}
const { title, description = SITE.description, type = 'website', image, tagline } = Astro.props;
const ogImage = image ? new URL(image, Astro.site) : undefined;
const fullTitle = title ? `${title} – ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="nb_NO" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wide bar">
        <a href="/" class="brand">{SITE.title}</a>
        <nav aria-label="Hovedmeny">
          {NAV.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <div class="tagline" data-tagline hidden={!tagline}>
      <p class="wide">{tagline && <>«{tagline.quote}» <span>{tagline.source}</span></>}</p>
    </div>
    <script is:inline define:vars={{ takk: NEWSLETTER.confirmMessage }}>
      // Kommer leseren fra bekreftelsen i Kit (?confirm), vises takkemeldingen i stedet for sitatet.
      const band = document.querySelector('[data-tagline]');
      const url = new URL(location.href);
      if (url.searchParams.has('confirm') && takk) {
        band.querySelector('p').textContent = takk;
        band.classList.add('notice');
        band.hidden = false;
        url.searchParams.delete('confirm');
        history.replaceState(null, '', url.pathname + url.search + url.hash);
      }
      // Linja glir bort etter 10 sekunder.
      if (!band.hidden) setTimeout(() => band.classList.add('gone'), 10000);
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wide">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span><a href="/rss.xml">RSS</a> · <a href="/nyhetsbrev/">Nyhetsbrev</a>{SITE.repo && <> · <a href={SITE.repo} rel="noopener">Kildekode på GitHub</a> · <a href={`${SITE.repo}/blob/main/docs/LAG-DITT-EGET.md`} rel="noopener">Lag dette selv</a></>}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--border); }
  .tagline { border-bottom: 1px solid var(--border); background: var(--surface); overflow: hidden; max-height: 8rem;
    transition: max-height 0.8s ease, opacity 0.6s ease, border-color 0.8s ease; }
  .tagline.notice { background: var(--accent); border-bottom-color: var(--accent); }
  .tagline.notice p { color: var(--bg); font-style: normal; font-family: var(--sans); font-weight: 600; }
  .tagline.gone { max-height: 0; opacity: 0; border-bottom-color: transparent; }
  @media (prefers-reduced-motion: reduce) { .tagline { transition: none; } }
  .tagline p { margin: 0; padding-block: 0.55rem; font-style: italic; font-size: 0.95rem; line-height: 1.45; color: var(--muted); text-align: center; }
  .tagline span { font-style: normal; font-family: var(--sans); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; margin-left: 0.35rem; }
  .bar {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem;
    align-items: center; justify-content: space-between; padding-block: 1.1rem;
  }
  .brand { font-size: 1.35rem; font-weight: 600; color: var(--text); text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; font-family: var(--sans); font-size: 0.95rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover, nav a[aria-current='page'] { color: var(--accent); }
  main { padding-block: 2.5rem 4rem; }
  .site-footer { border-top: 1px solid var(--border); padding-block: 1.5rem; }
  .site-footer .wide {
    display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: space-between;
    font-family: var(--sans); font-size: 0.85rem; color: var(--muted);
  }
</style>
