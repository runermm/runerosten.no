---
import { SITE } from '../config';
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---
<Base title="Nyhetsbrev" description={`Meld deg på nyhetsbrevet til ${SITE.author}.`}>
  <div class="wrap">
    <h1>Nyhetsbrev</h1>
    <p class="lead">Nyhetsbrevet kommer hver fredag morgen, med nye synspunkter, bokmeldinger og det jeg har lest, hørt på og tenkt på i uka som gikk.</p>
    <NewsletterForm />
  </div>
</Base>
