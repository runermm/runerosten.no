---
// «Oppmøte ute og inne»: økter fra Strava (ute) og arrangementer som konserter og kino (inne),
// vist kronologisk om hverandre (src/data/oppmote.json).
import data from '../data/oppmote.json';
import { formatDate } from '../lib';

type Ute = 'sykkel' | 'løping' | 'tur' | 'ski' | 'svømming' | 'trening';
type Inne = 'konsert' | 'kino' | 'teater' | 'foredrag' | 'annet';
export interface Event {
  type: Ute | Inne;
  detail?: string; // kort og gjerne kryptisk, f.eks. «87 km» eller «4:12 t»
  title: string; // f.eks. artist, film eller forestilling
  venue?: string; // sted
  city?: string;
  date: string; // ÅÅÅÅ-MM-DD
  note?: string; // en setning fra deg
  image?: string;
  url?: string;
}
interface Props { limit?: number }
const { limit = 4 } = Astro.props;
const events = (data.events as Event[]).slice().sort((a, b) => b.date.localeCompare(a.date)).slice(0, limit || undefined);
const UTE = ['sykkel', 'løping', 'tur', 'ski', 'svømming', 'trening'];
const LABEL: Record<Event['type'], string> = {
  sykkel: 'Sykkel', løping: 'Løping', tur: 'Tur', ski: 'Ski', svømming: 'Svømming', trening: 'Trening',
  konsert: 'Konsert', kino: 'Kino', teater: 'Teater', foredrag: 'Foredrag', annet: 'Arrangement',
};
const ICON: Record<Event['type'], string> = {
  sykkel: '◎', løping: '»', tur: '▲', ski: '❄', svømming: '≈', trening: '•',
  konsert: '♪', kino: '▶', teater: '◐', foredrag: '❝', annet: '✦',
};
---
{events.length > 0 && (
  <ul class="events">
    {events.map((e) => (
      <li class:list={['event', { 'has-image': e.image }]} data-side={UTE.includes(e.type) ? 'ute' : 'inne'}>
        {e.image ? <img src={e.image} alt="" loading="lazy" /> : <span class="icon" aria-hidden="true">{ICON[e.type]}</span>}
        <div class="body">
          <p class="kicker"><span class="badge">{UTE.includes(e.type) ? 'Ute' : 'Inne'} · {LABEL[e.type]}</span>{e.detail && <span>{e.detail}</span>} <time datetime={e.date}>{formatDate(new Date(e.date))}</time></p>
          <h3>{e.url ? <a href={e.url} target="_blank" rel="noopener">{e.title}</a> : e.title}</h3>
          {(e.venue || e.city) && <p class="where">{[e.venue, e.city].filter(Boolean).join(', ')}</p>}
          {e.note && <p class="note">{e.note}</p>}
        </div>
      </li>
    ))}
  </ul>
)}
<style>
  .events { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .event { display: flex; gap: 0.9rem; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 0.9rem; }
  .event img { flex: 0 0 5.5rem; width: 5.5rem; height: auto; align-self: flex-start; border-radius: 8px; }
  .icon { flex: 0 0 4.5rem; width: 4.5rem; height: 4.5rem; border-radius: 8px; }
  .icon { display: grid; place-items: center; font-size: 1.6rem; color: var(--bg); background: var(--accent); }
  .body { min-width: 0; }
  .kicker { margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-family: var(--sans); font-size: 0.75rem; color: var(--muted); }
  .badge { text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; font-size: 0.66rem; color: var(--accent); }
  h3 { margin: 0.2rem 0 0; font-size: 1.05rem; line-height: 1.3; }
  h3 a { color: var(--text); text-decoration: none; }
  .where { margin: 0.1rem 0 0; font-family: var(--sans); font-size: 0.8rem; color: var(--muted); }
  .note { margin: 0.35rem 0 0; font-size: 0.92rem; line-height: 1.45; }
</style>
