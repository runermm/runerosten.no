---
import type { LeselisteEntry } from '../lib';
import { formatDate } from '../lib';
import Rating from './Rating.astro';

interface Props { item: LeselisteEntry }
const { item } = Astro.props;
const isBook = item.type === 'bok';
// Stabil farge per bok for tegnede omslag.
const hues = [14, 32, 152, 200, 262, 340];
const hue = hues[[...item.title].reduce((n, c) => n + c.charCodeAt(0), 0) % hues.length];
---
<article class:list={['card', isBook ? 'book' : 'article']} data-type={item.type}>
  {isBook ? (
    <a href={item.url} class="cover" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
      {item.image ? (
        <img src={item.image} alt="" loading="lazy" />
      ) : (
        <span class="drawn" style={`--h:${hue}`}>
          <span class="drawn-title">{item.title}</span>
          {item.author && <span class="drawn-author">{item.author}</span>}
        </span>
      )}
    </a>
  ) : (
    item.image && (
      <a href={item.url} class="thumb" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
        <img src={item.image} alt="" loading="lazy" />
      </a>
    )
  )}
  <div class="body">
    <p class="kicker">
      <span class="badge">{isBook ? 'Bok' : 'Artikkel'}</span>
      {!isBook && <span>{item.source}</span>}
    </p>
    <h3><a href={item.url} target="_blank" rel="noopener">{item.title}</a></h3>
    {item.author && <p class="author">{item.author}</p>}
    {item.note && <p class="note">{item.note}</p>}
    <p class="foot">
      <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
      {item.review && (
        <a href={item.review.href} class="review">{item.review.rating && <Rating value={item.review.rating} size={18} />} Les anmeldelsen</a>
      )}
    </p>
  </div>
</article>

<style>
  .card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    overflow: hidden; display: flex; flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.25); }
  .thumb img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .book { flex-direction: row; gap: 1.1rem; padding: 1.1rem; }
  .cover { flex: 0 0 6.5rem; }
  .cover img, .drawn {
    display: block; width: 6.5rem; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 3px 6px 6px 3px;
    box-shadow: inset 4px 0 6px -3px rgb(0 0 0 / 0.35), 0 6px 14px -6px rgb(0 0 0 / 0.45);
  }
  .drawn {
    background: linear-gradient(160deg, hsl(var(--h) 45% 38%), hsl(var(--h) 50% 24%));
    color: hsl(var(--h) 40% 94%); padding: 0.7rem 0.6rem;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .drawn-title { font-size: 0.95rem; font-weight: 600; line-height: 1.2; }
  .drawn-author { font-family: var(--sans); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.85; }
  .body { padding: 1.1rem 1.2rem 1rem; display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .book .body { padding: 0; }
  .kicker {
    margin: 0 0 0.4rem; display: flex; gap: 0.6rem; align-items: center;
    font-family: var(--sans); font-size: 0.78rem; color: var(--muted);
  }
  .badge {
    text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; font-size: 0.68rem;
    color: var(--accent); border: 1px solid currentColor; border-radius: 999px; padding: 0.05rem 0.5rem;
  }
  h3 { margin: 0; font-size: 1.2rem; line-height: 1.3; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .author { margin: 0.15rem 0 0; font-style: italic; color: var(--muted); }
  .note { margin: 0.7rem 0 0; font-size: 1rem; line-height: 1.55; }
  .foot {
    margin: auto 0 0; padding-top: 0.8rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; align-items: center;
    font-family: var(--sans); font-size: 0.8rem; color: var(--muted);
  }
  .review { display: inline-flex; gap: 0.35rem; align-items: center; font-weight: 600; text-decoration: none; }
</style>
