---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { getArtikler, formatDate } from '../../lib';

export async function getStaticPaths() {
  const artikler = await getArtikler();
  return artikler.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, updated, tags, draft, linkedin, image, imageAlt, imageCredit, imagePortrait } = entry.data;
---
<Base title={title} description={description} type="article" image={image}>
  <article class="wrap">
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {updated && <> · oppdatert {formatDate(updated)}</>}
      {draft && <> · <strong>UTKAST</strong></>}
    </p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    {image && (
      <figure class:list={["hero", { portrait: imagePortrait }]}>
        <img src={image} alt={imageAlt ?? ''} />
        {imageCredit && <figcaption class="meta">{imageCredit}</figcaption>}
      </figure>
    )}
    <div class="prose"><Content /></div>
    {linkedin && <p class="meta">Først publisert på <a href={linkedin} target="_blank" rel="noopener">LinkedIn</a>.</p>}
    {tags.length > 0 && <p class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</p>}
    <NewsletterForm />
  </article>
</Base>
<style>
  .hero { margin: 1.75rem 0 2rem; }
  .hero img { display: block; width: 100%; height: auto; border-radius: 10px; box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.45); }
  .hero figcaption { margin-top: 0.5rem; }
  .hero.portrait img { width: auto; max-width: 100%; max-height: 38rem; margin: 0 auto; }
  .hero.portrait figcaption { text-align: center; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
</style>
