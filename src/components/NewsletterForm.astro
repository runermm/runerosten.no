---
import { NEWSLETTER } from '../config';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const user = NEWSLETTER.buttondownUsername;
const action = `https://buttondown.com/api/emails/embed-subscribe/${user}`;
---
<section class:list={['newsletter', { compact }]}>
  <h2>Få nye tekster på e-post</h2>
  <p>Nyhetsbrev med nye artikler og bokanmeldelser. Ingen spam, og du kan melde deg av når som helst.</p>
  {user ? (
    <form action={action} method="post" target="_blank">
      <label for="nl-email" class="sr-only">E-postadresse</label>
      <input id="nl-email" type="email" name="email" required placeholder="din@epost.no" autocomplete="email" />
      <button type="submit">Meld meg på</button>
    </form>
  ) : (
    <p class="todo">Påmeldingen er ikke aktivert ennå. Sett <code>buttondownUsername</code> i <code>src/config.ts</code>.</p>
  )}
</section>
<style>
  .newsletter {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 1.5rem; margin: 3rem 0;
  }
  h2 { margin: 0 0 0.25rem; font-size: 1.35rem; }
  p { margin: 0 0 1rem; color: var(--muted); }
  form { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  input {
    flex: 1 1 14rem; font: inherit; font-family: var(--sans); font-size: 1rem;
    padding: 0.6rem 0.8rem; border: 1px solid var(--border); border-radius: 6px;
    background: var(--bg); color: var(--text);
  }
  button {
    font-family: var(--sans); font-size: 1rem; font-weight: 600;
    padding: 0.6rem 1.1rem; border: 0; border-radius: 6px;
    background: var(--accent); color: var(--bg); cursor: pointer;
  }
  button:hover { filter: brightness(1.1); }
  .todo { font-family: var(--sans); font-size: 0.9rem; margin: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
