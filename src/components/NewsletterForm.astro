---
import { NEWSLETTER } from '../config';
// kort = kompakt variant på forsiden, vist bare på «mobil» eller bare på «pc»
interface Props { compact?: boolean; kort?: 'mobil' | 'pc' }
const { compact = false, kort } = Astro.props;
const formId = NEWSLETTER.kitFormId;
const action = `https://app.kit.com/forms/${formId}/subscriptions`;
const inputId = kort ? `nl-email-${kort}` : 'nl-email';
---
{kort && !formId ? null : (
<section class:list={['newsletter', { compact, kort: !!kort, [`kort-${kort}`]: !!kort }]}>
  {!kort && (
    <>
      <h2>Få nye tekster på e-post</h2>
      <p>Hver fredag morgen: nye synspunkter, bokmeldinger og det jeg har lest og hørt på. Ingen spam, og du kan melde deg av når som helst.</p>
    </>
  )}
  {formId && kort ? (
    <form action={action} method="post" data-kit-form>
      <div class="pille">
        <label for={inputId} class="kort-t">Ukentlig nyhetsbrev</label>
        <input id={inputId} type="email" name="email_address" required placeholder="din e-post" autocomplete="email" />
        <button type="submit" aria-label="Meld meg på">Meld på</button>
      </div>
      <p class="status" role="status" hidden></p>
    </form>
  ) : formId ? (
    <form action={action} method="post" data-kit-form>
      <label for={inputId} class="sr-only">E-postadresse</label>
      <input id={inputId} type="email" name="email_address" required placeholder="din@epost.no" autocomplete="email" />
      <button type="submit">Meld meg på</button>
      <p class="status" role="status" hidden></p>
    </form>
  ) : (
    <p class="todo">Påmeldingen er ikke aktivert ennå. Sett <code>kitFormId</code> i <code>src/config.ts</code>.</p>
  )}
</section>
)}
<style>
  .newsletter {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 1.5rem; margin: 3rem 0;
  }
  h2 { margin: 0 0 0.25rem; font-size: 1.35rem; }
  p { margin: 0 0 1rem; color: var(--muted); }
  form { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  input {
    flex: 1 1 14rem; font: inherit; font-family: var(--sans); font-size: 1rem;
    padding: 0.6rem 0.8rem; border: 1px solid var(--border); border-radius: 6px;
    background: var(--bg); color: var(--text);
  }
  button {
    font-family: var(--sans); font-size: 1rem; font-weight: 600;
    padding: 0.6rem 1.1rem; border: 0; border-radius: 6px;
    background: var(--accent); color: var(--bg); cursor: pointer;
  }
  button:hover { filter: brightness(1.1); }
  .status { flex-basis: 100%; margin: 0.25rem 0 0; font-family: var(--sans); font-size: 0.95rem; color: var(--text); }
  .todo { font-family: var(--sans); font-size: 0.9rem; margin: 0; }
  /* Kompakt variant: én tynn linje med etikett, e-postfelt og knapp i samme «pille» */
  .kort { background: none; border: 0; padding: 0; margin: 0 0 1.25rem; }
  .kort form { display: block; }
  .pille { display: flex; align-items: center; gap: 0.4rem; border: 1px solid var(--border); border-radius: 999px;
    background: var(--surface); padding: 0.25rem 0.25rem 0.25rem 0.9rem; }
  .pille:focus-within { border-color: var(--accent); }
  .kort .kort-t { flex: none; font-family: var(--sans); font-size: 0.85rem; font-weight: 600; color: var(--text); white-space: nowrap; }
  .kort input { flex: 1 1 auto; min-width: 0; border: 0; background: transparent; padding: 0.4rem 0.3rem; font-size: 0.95rem; }
  .kort input:focus { outline: none; }
  .kort button { flex: none; border-radius: 999px; padding: 0.4rem 0.9rem; font-size: 0.9rem; white-space: nowrap; }
  .kort .status { margin: 0.4rem 0 0 0.9rem; font-size: 0.9rem; }
  .kort-pc { margin: 2rem 0 0; max-width: 32rem; }
  @media (min-width: 34.01rem) { .kort-mobil { display: none; } }
  @media (max-width: 34rem) { .kort-pc { display: none; } }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>

<script>
  // Sender påmeldingen i bakgrunnen, så leseren blir på siden.
  document.querySelectorAll<HTMLFormElement>('form[data-kit-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.status')!;
      const button = form.querySelector('button')!;
      button.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        // Kit svarer 200 også ved feil; selve resultatet står i «status».
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.status !== 'success') {
          status.textContent = 'Det gikk ikke. Sjekk at e-postadressen er riktig og prøv igjen.';
          status.hidden = false;
          button.disabled = false;
          return;
        }
        form.reset();
        status.textContent = 'Takk! Sjekk innboksen din og bekreft påmeldingen.';
      } catch (err) {
        // Blokkert av nettleseren (CORS): send skjemaet på vanlig måte til Kit i stedet.
        if (err instanceof TypeError) return HTMLFormElement.prototype.submit.call(form);
        status.textContent = 'Noe gikk galt. Prøv igjen litt senere.';
        button.disabled = false;
      }
      status.hidden = false;
    });
  });
</script>
