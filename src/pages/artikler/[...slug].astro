---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { getArtikler, formatDate } from '../../lib';

export async function getStaticPaths() {
  const artikler = await getArtikler();
  return artikler.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, updated, tags, draft } = entry.data;
---
<Base title={title} description={description} type="article">
  <article class="wrap">
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {updated && <> · oppdatert {formatDate(updated)}</>}
      {draft && <> · <strong>UTKAST</strong></>}
    </p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <div class="prose"><Content /></div>
    {tags.length > 0 && <p class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</p>}
    <NewsletterForm />
  </article>
</Base>
<style>
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
</style>
