---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import LeselisteCard from '../components/LeselisteCard.astro';
import BookCover from '../components/BookCover.astro';
import PaRepeat from '../components/PaRepeat.astro';
import Oppmote from '../components/Oppmote.astro';
import { leserNa } from '../bokhylle';
import { SITE } from '../config';
import oppmote from '../data/oppmote.json';
import musikk from '../data/musikk.json';
import { PODKAST } from '../config';
import { getArtikler, getAnmeldelser, getLeseliste, reviewListTitle, reviewImage } from '../lib';

// Én felles, kronologisk feed med synspunkter (artikler) og bokmeldinger (anmeldelser).
const SYNSPUNKT = { label: 'Synspunkt', href: '/artikler/' };
const BOKMELDING = { label: 'Bokmelding', href: '/anmeldelser/' };
const [artikler, anmeldelser] = await Promise.all([getArtikler(), getAnmeldelser()]);
const innlegg = await Promise.all([
  ...artikler.map(async (a) => ({
    href: `/artikler/${a.id}/`, title: a.data.title, description: a.data.description, date: a.data.date,
    image: a.data.image, imageWide: !a.data.imagePortrait,
    tag: SYNSPUNKT, Content: (await render(a)).Content,
  })),
  ...anmeldelser.map(async (b) => ({
    href: `/anmeldelser/${b.id}/`, ...reviewListTitle(b.data), image: reviewImage(b.data),
    description: b.data.description, date: b.data.date, rating: b.data.rating,
    tag: BOKMELDING, Content: (await render(b)).Content,
  })),
]);
innlegg.sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Feeden deles opp med faste seksjoner imellom: 3 innlegg, Leser nå, 3 innlegg, På øret …, 3 innlegg, Fra leselisten, resten.
const del = [innlegg.slice(0, 3), innlegg.slice(3, 6), innlegg.slice(6, 9), innlegg.slice(9)];
const leseliste = (await getLeseliste()).slice(0, 3);
const naa = leserNa(6);
const harOppmote = oppmote.events.length > 0;
const harMusikk = musikk.albums.length > 0 || PODKAST.collectionId > 0;
---
<Base tagline={SITE.tagline ?? undefined}>
  <div class="wrap">

    <div class="feed"><PostList items={del[0]} /></div>

    {naa.length > 0 && (
      <section class="block">
        <div class="section-head"><h2>Leser nå</h2><a href="/bokhylle/">Hele boksamlingen →</a></div>
        <ul class="now">
          {naa.map((b) => (
            <li title={`${b.title}${b.author ? ' – ' + b.author : ''}`}>
              <BookCover bok={b} width={240} />
              <span class="now-t">{b.title}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {del[1].length > 0 && <div class="feed"><PostList items={del[1]} /></div>}

    {harMusikk && (
      <section class="block">
        <div class="section-head"><h2>På øret og på repeat</h2><span class="meta">Album og podkaster</span></div>
        <PaRepeat />
      </section>
    )}

    {harOppmote && (
      <section class="block">
        <div class="section-head"><h2>Oppmøte</h2><span class="meta">Konserter, kino og andre arrangementer</span></div>
        <Oppmote />
      </section>
    )}

    {del[2].length > 0 && <div class="feed"><PostList items={del[2]} /></div>}

    <NewsletterForm />

    {leseliste.length > 0 && (
      <section class="block">
        <div class="section-head"><h2>Fra leselisten</h2><a href="/leseliste/">Hele leselisten →</a></div>
        <div class="stack">{leseliste.map((item) => <LeselisteCard item={item} />)}</div>
      </section>
    )}

    {del[3].length > 0 && (
      <section class="block">
        <div class="section-head"><h2>Fra arkivet</h2></div>
        <div class="feed archive"><PostList items={del[3]} /></div>
      </section>
    )}
  </div>
</Base>

<style>
  .feed { margin-top: 1.5rem; border-top: 1px solid var(--border); }
  .feed:first-child { margin-top: 0; border-top: 0; }
  .block { margin: 2.5rem 0 1rem; }
  .block .section-head { margin-top: 0; }
  .feed.archive { margin-top: 0; border-top: 0; }
  .stack { display: grid; gap: 1rem; margin-top: 1.25rem; }
  .now { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(6, 1fr); }
  .now-t { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    margin-top: 0.45rem; font-size: 0.8rem; line-height: 1.3; font-weight: 600; }
  @media (max-width: 34rem) { .now { grid-template-columns: repeat(3, 1fr); } }
</style>
